{
  "name": "curler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:debug": "CURLER_DEBUG=1 node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch-path=./server server/index.mjs",
    "build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc -b",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "check": "node scripts/check-config.mjs && node scripts/check-curl.mjs && node scripts/check-vars.mjs && node scripts/check-terminal-flags.mjs && node scripts/check-diff.mjs && node scripts/check-compare.mjs && node scripts/check-response.mjs && node scripts/check-engine.mjs && node scripts/check-storage.mjs && node scripts/check-theme.mjs",
    "check:verbose": "CURLER_VERBOSE=1 npm run check --silent",
    "check:config": "node scripts/check-config.mjs",
    "check:curl": "node scripts/check-curl.mjs",
    "check:vars": "node scripts/check-vars.mjs",
    "check:diff": "node scripts/check-diff.mjs",
    "check:compare": "node scripts/check-compare.mjs",
    "check:response": "node scripts/check-response.mjs",
    "check:flags": "node scripts/check-terminal-flags.mjs",
    "check:engine": "node scripts/check-engine.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "cm6-graphql": "^0.2.1",
    "codemirror": "^6.0.2",
    "graphql": "^17.0.2",
    "js-beautify": "^2.0.3",
    "keytar": "^7.9.0",
    "material-icons": "^1.13.14",
    "shell-quote": "^1.10.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^24.13.3",
    "@types/shell-quote": "^1.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
